    <RootNamespace>SignRelay.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <PackageId>Nefarius.Tools.SignRelay</PackageId>
    <ToolCommandName>signrelay</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignRelay.Contracts\SignRelay.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.CommandLine is pinned to a beta release; see Directory.Packages.props -->
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
