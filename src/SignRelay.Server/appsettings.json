{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "AutoDetectPrivateNetworks": true,
    "AllowFromAny": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "SignRelay": {
    "CiToken": "",
    "AgentToken": "",
    "StoragePath": "data",
    "MaxTotalJobBytes": 536870912,
    "JobTimeToLive": "02:00:00",
    "ArtifactCleanupDelay": "01:00:00",
    "JobRecordRetention": "7.00:00:00"
  }
}
