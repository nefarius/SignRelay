<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>CS0649;CS0169;CS8981</NoWarn>
    <!-- Opt out of Central Package Management — NUKE pins its own version -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NukeRootDirectory>..</NukeRootDirectory>
    <NukeScriptDirectory>..</NukeScriptDirectory>
    <RootNamespace></RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nuke.Common" Version="10.1.0" />
    <!-- Force-pin transitive Nuke deps to versions with no known CVEs -->
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
</Project>
